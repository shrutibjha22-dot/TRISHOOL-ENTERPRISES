# ============================================================
#  TRISHOOL ENTERPRISES — environment configuration
#
#  Copy this file to `.env` and fill in your real values.
#  `.env` is listed in .gitignore and is NEVER committed.
# ============================================================

# ---------- server ----------
NODE_ENV=development
PORT=3000

# 0.0.0.0 = accept connections from other devices on your network, so you can
#           open the site and the admin dashboard from a phone or another
#           laptop on the same Wi-Fi.
# 127.0.0.1 = this computer only. Safer, but nothing else can reach it.
#
# If you change this to 0.0.0.0 you must also open the Windows Firewall, or
# other devices will still be blocked. Run ALLOW-PHONE-ACCESS.bat as
# Administrator once.
HOST=127.0.0.1

# Only needed if the frontend is hosted on a different address than the API.
# Leave blank when the website and API are served by the same process.
PUBLIC_ORIGIN=

# How many reverse proxies (Nginx, a load balancer, a hosting platform) sit in
# front of this server. Leave BLANK when customers reach Node directly - that is
# the normal case, and the rate limiter then uses the real socket address.
# Set to 1 only when you put exactly one proxy in front, so rate limiting can
# read the true client IP from X-Forwarded-For.
#
# Do not set this when there is no proxy. Anyone could then send a fake
# X-Forwarded-For header and get a fresh rate-limit allowance on every request.
TRUST_PROXY=

# ---------- database ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Fill this in. Leave it blank only if your MySQL root account really has no
# password, which is not the default for MySQL or MariaDB.
DB_PASSWORD=
DB_NAME=trishool_db
DB_POOL_SIZE=10

# ---------- authentication ----------
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_this_with_a_long_random_string_before_going_live
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

AUTH_COOKIE_NAME=trishool_admin_token
# Set to true once the site is served over https. Required in production.
AUTH_COOKIE_SECURE=false

# ---------- business details ----------
# Used by the API so these values live in one place.
BUSINESS_NAME=TRISHOOL ENTERPRISES
BUSINESS_WHATSAPP=919082278478
BUSINESS_UPI_ID=9324534405@ptaxis
GST_RATE=18

# ---------- first-run admin ----------
# Used only by `npm run db:seed`. Fill in your own address - it is deliberately
# blank here so no real one is published in the repository.
# Leave ADMIN_SEED_PASSWORD blank and db:seed will generate one and print it
# exactly once.
ADMIN_SEED_EMAIL=
ADMIN_SEED_NAME=Trishool Admin
ADMIN_SEED_PASSWORD=
